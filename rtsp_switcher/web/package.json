{
  "name": "rtsp-switcher-webui",
  "private": true,
  "description": "Web UI for the Youtube Live Manager addon, bundled into dist/app.js at image build time",
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
